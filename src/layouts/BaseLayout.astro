---
import '../index.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Juniors AI | Customer Support on Your Infrastructure',
  description = 'AI customer support console where you bring your own infrastructure. No vendor lock-in, no LLM markup, no data on our servers. Full control over your support stack.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/webp" href="/favicon.webp" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://juniors.ai" />
    <meta property="og:image" content="https://juniors.ai/logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://juniors.ai/logo.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
